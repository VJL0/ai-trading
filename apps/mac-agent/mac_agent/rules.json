  "secret_text_patterns": [
    "sk-ant-[A-Za-z0-9_-]{8,}",
    "sk-[A-Za-z0-9_-]{16,}",
    "\\b(PK|AK|CK)[A-Z0-9]{14,}\\b",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "\\b(ghp|gho|ghs|github_pat)_[A-Za-z0-9_]{16,}",
    "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "(api[_-]?key|secret|token|password|passwd|authorization)\\s*[=:]\\s*\\S{6,}",
    "\\b[A-Za-z0-9+/_-]{40,}={0,2}"
  ],
  "audit_redact_patterns": [
    "sk-ant-[A-Za-z0-9_-]{8,}",
    "sk-[A-Za-z0-9_-]{16,}",
    "\\b(PK|AK|CK)[A-Z0-9]{14,}\\b",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(-----END [A-Z ]*PRIVATE KEY-----|$)",
