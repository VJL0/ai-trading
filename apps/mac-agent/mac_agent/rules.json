        "up",
        "down",
        "left",
        "right",
        "cmd+n"
      ]
    },
    {
      "key": "textedit",
      "names": [
        "TextEdit"
      ],
      "bundle_ids": [
        "com.apple.TextEdit"
      ],
      "capabilities": [
        "list",
        "inspect",
        "screenshot",
        "click",
        "type",
        "press",
        "launch",
        "focus"
      ],
      "type_charset": null,
      "keys": [
        "return",
        "tab",
        "escape",
        "up",
        "down",
        "left",
        "right",
        "cmd+n"
      ]
    },
    {
      "key": "finder",
      "names": [
        "Finder"
      ],
      "bundle_ids": [
        "com.apple.finder"
      ],
      "capabilities": [
        "list",
        "inspect",
        "screenshot",
        "click",
        "launch",
        "focus"
      ],
      "type_charset": null,
      "keys": []
    },
    {
      "key": "terminal",
      "names": [
        "Terminal",
        "iTerm2",
        "iTerm"
      ],
      "bundle_ids": [
        "com.apple.Terminal",
        "com.googlecode.iterm2"
      ],
      "capabilities": [
        "list",
        "inspect"
      ],
      "type_charset": null,
      "keys": [],
      "note": "Read-only accessibility inspection with redaction. Typing, key presses, clicks and screenshots are denied (terminals can display secrets).",
      "redact_values": true
    },
    {
      "key": "ide",
      "names": [
        "Code",
        "Visual Studio Code",
        "Cursor",
        "Xcode",
        "Zed"
      ],
      "bundle_ids": [
        "com.microsoft.VSCode",
        "com.todesktop.230313mzl4w4u92",
        "com.apple.dt.Xcode",
        "dev.zed.Zed"
      ],
      "capabilities": [
        "list",
        "inspect",
        "screenshot"
      ],
      "type_charset": null,
      "keys": [],
      "note": "Read-only inspection/screenshot; screenshots are denied when the window title looks sensitive.",
      "redact_values": true,
      "screenshot_precheck": true
    }
  ],
  "browser_apps": [
    {
      "key": "playwright_chromium",
      "names": [
        "Google Chrome for Testing",
        "Chromium"
      ],
      "bundle_ids": [
        "com.google.chrome.for.testing",
        "org.chromium.Chromium"
      ],
      "capabilities": [
        "list",
        "inspect",
        "screenshot",
        "click",
        "type",
        "focus"
      ],
      "keys": [
        "return",
        "tab",
        "escape",
        "up",
        "down",
        "left",
        "right"
      ],
      "note": "Only the Playwright-launched browser (route-level URL allowlist + host-resolver lockdown) may be driven by Peekaboo, only while its window title identifies an allowlisted surface bound by our own Playwright process, and only inside the page's AXWebArea (never the address bar, tabs or menus). Key presses through Peekaboo are not allowed for browsers (focus could be in the address bar); Playwright presses keys on a located element. The user's everyday Chrome/Safari profiles are not allowlisted for native control."
    }
  ],
