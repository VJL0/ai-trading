# Copy to .env. The trading modes are Paper and Live. Live is unavailable in this build.

# Optional Alpaca paper credentials. Paper key IDs start with PK. macOS Keychain also works.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Operator controls
# LAT_TRADING_MODE=PAPER              # Paper or Live. Setting Paper enables Alpaca paper routing when keys are available.
# LAT_AGENT_MAX_PROPOSALS_PER_HOUR=6   # Direct agent proposals. Sessions also follow the active risk policy.

# Research maintenance (no order authority). After each XNYS close, outside pre-market and regular hours, the API runs
# fetch-delta, build-panel, scan and shadow in low-priority child processes limited to 60 data requests/minute.
# LAT_QUANTLAB_DAILY_ENABLED=false

# Research crew (services/agents; research only, no order authority). Runs your installed Claude Code and Codex CLIs
# on their own subscription sign-in; API-key variables are removed from the agents' environment. `make agents`.
# LAT_AGENTS_PROVIDERS=claude,codex
# LAT_AGENTS_CLAUDE_BIN=claude
# LAT_AGENTS_CODEX_BIN=codex
# LAT_AGENTS_MODEL_CLAUDE=                 # empty = the CLI's configured default
# LAT_AGENTS_MODEL_CODEX=
# LAT_AGENTS_MAX_CONCURRENT=1
# LAT_AGENTS_DAILY_RUNS_PER_PROVIDER=12
# LAT_AGENTS_RUN_TIMEOUT_S=900
# LAT_AGENTS_MAX_TURNS=12
# LAT_AGENTS_SPECS_PER_TASK=3
# LAT_AGENTS_COOLDOWN_MINUTES=60           # after a usage limit with no stated reset; doubles, capped at 12 h
# LAT_AGENTS_REVIEW_WAIT_HOURS=24          # a review waits this long for the other provider, then expires
# LAT_AGENTS_IDLE_SLEEP_S=600
# LAT_AGENTS_STORE=experiments/agents/crew.sqlite3
# LAT_AGENTS_WINDOW_RUNS_PER_PROVIDER=8    # subscription limit: runs per provider in a rolling window (0 = off)
# LAT_AGENTS_WINDOW_HOURS=5
# LAT_AGENTS_MAX_PER_PROVIDER=1            # parallel runs per provider in the standalone crew loop
# LAT_AGENTS_PLANNER=rules                 # rules = the crew's own planner; lead = only the lead agent enqueues work
# Lead agent (`python -m services.agents lead`, launched by the autopilot; docs/architecture/lead-agent.md).
# LAT_AGENTS_LEAD_PROVIDERS=claude,codex   # who leads, in order; the next one takes over on a usage limit
# LAT_AGENTS_LEAD_TIMEOUT_S=600            # one lead turn
# LAT_AGENTS_LEAD_MAX_TURNS=16
# LAT_AGENTS_LEAD_MAX_PARALLEL=3           # subagents running at once
# LAT_AGENTS_LEAD_PER_PROVIDER=2
# LAT_AGENTS_LEAD_DELEGATIONS_PER_CYCLE=4
# LAT_AGENTS_LEAD_DELEGATIONS_PER_DAY=16
# LAT_AGENTS_LEAD_RESERVE_RUNS=2           # last runs per provider/day/window kept for the lead's own turns
# LAT_AGENTS_LEAD_MIN_WAKE_MIN=20
# LAT_AGENTS_LEAD_MAX_WAKE_MIN=240
# LAT_AGENTS_LEAD_BRIEFING=                # set by the autopilot (--briefing); empty outside it

# SEC EDGAR point-in-time filings (services/market_data/edgar). Used only by the explicit
# `python -m services.market_data.edgar fetch` command; downloads are refused while unset.
# SEC fair-access policy asks for a name and contact email, e.g. "Name email".
# LAT_SEC_USER_AGENT=

# --- autopilot (services/autopilot; docs/runbooks/autopilot.md). Paper only; off by default.
# LAT_AUTOPILOT_ENABLED=false
# LAT_AUTOPILOT_TICK_S=60
# LAT_AUTOPILOT_PREOPEN_LEAD_MIN=60
# LAT_AUTOPILOT_START_GRACE_MIN=5
# LAT_AUTOPILOT_PREOPEN_RECHECK_MIN=5
# LAT_AUTOPILOT_INTRADAY_INTERVAL_MIN=15
# LAT_AUTOPILOT_SETTLE_MIN=30
# LAT_AUTOPILOT_SESSION_MINUTES=          # empty = full regular session minus the 30-min entry cutoff
# LAT_AUTOPILOT_CADENCE_MINUTES=
# LAT_AUTOPILOT_SYMBOLS=
# LAT_AUTOPILOT_USE_AI=false
# LAT_AUTOPILOT_START_API=true
# LAT_AUTOPILOT_RESEARCH=true
# LAT_AUTOPILOT_CREW_TICKS=2                # only when LAT_AUTOPILOT_LEAD=false
# LAT_AUTOPILOT_CREW_TIMEOUT_S=3600
# LAT_AUTOPILOT_HOLDOUT=true
# LAT_AUTOPILOT_STEP_TIMEOUT_S=7200
# LAT_AUTOPILOT_LEAD=true                  # lead agent cycles from pre-open to the end of the evening research window
# LAT_AUTOPILOT_LEAD_MAX_CYCLES=10         # lead turns per trading day
# LAT_AUTOPILOT_LEAD_MIN_INTERVAL_MIN=20
# LAT_AUTOPILOT_LEAD_MAX_INTERVAL_MIN=180
# LAT_AUTOPILOT_LEAD_TIMEOUT_S=2700        # one cycle: lead turn plus parallel subagents
# LAT_AUTOPILOT_LEAD_SESSION_ACTIONS=true  # honour fail-safe requests (stand down today, request a halt)
# LAT_AUTOPILOT_LEAD_FAKE=false            # simulated lead/subagents for disposable workspaces only
# LAT_AUTOPILOT_STATE_DIR=experiments/autopilot
# LAT_AUTOPILOT_REPORT_DIR=experiments/autopilot/reports
