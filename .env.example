# Copy to .env (git-ignored) for development, or — preferred — store secrets in the macOS Keychain:
#   security add-generic-password -s local-ai-trader -a ALPACA_PAPER_KEY_ID -w
# Lookup order: Keychain -> process env -> .env. Values are never logged or sent to models/GUI agents.

# --- Alpaca PAPER credentials (paper.alpaca.markets). Paper key ids start with "PK". ---
# The ambiguous upstream names APCA_API_KEY_ID / APCA_API_SECRET_KEY are deliberately IGNORED.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# --- Model APIs (separate API billing; Claude Pro / ChatGPT Plus subscriptions do NOT cover these) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Non-secret runtime settings (env prefix LAT_) ---
# LAT_MODE=PAPER                 # RESEARCH_ONLY | REPLAY | PAPER (default). Live modes are compiled off.
# LAT_GATEWAY=ALPACA_PAPER       # official SDK paper execution; FAKE for explicit simulation
# Export LAT_* settings in the shell; this .env file is read for secrets only.
# LAT_FEED_MODE=                 # IEX_FREE | SIP_PAID | SIMULATED (empty = IEX_FREE if paper keys else SIMULATED)
# LAT_AI_TRANSPORT=fake          # fake | real  ('real' calls paid model APIs; must be set explicitly)
# LAT_CLAUDE_EFFORT=high         # high | xhigh | max
# LAT_SOL_EFFORT=medium          # low | medium | high
# LAT_API_PORT=8765
# LAT_DASHBOARD_PORT=5173

# Live credentials are never read from here. ALPACA_LIVE_* names exist only so the live release gate can
# report presence; that gate is compiled off in this build.
