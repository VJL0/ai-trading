<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>LatStrategies.Tests</AssemblyName>
    <RootNamespace>Lat.Lean.Tests</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;NU1605;NU1903;NU1904;NUnit2005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- exact versions (lock file enabled); NUnit/adapter match the pinned LEAN Tests project -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LatStrategies\LatStrategies.csproj" />
    <ProjectReference Include="..\Lean\Common\QuantConnect.csproj" />
    <ProjectReference Include="..\Lean\Brokerages\QuantConnect.Brokerages.csproj" />
    <ProjectReference Include="..\Lean\Engine\QuantConnect.Lean.Engine.csproj" />
    <ProjectReference Include="..\Lean\Algorithm\QuantConnect.Algorithm.csproj" />
    <ProjectReference Include="..\Lean\Configuration\QuantConnect.Configuration.csproj" />
    <ProjectReference Include="..\Lean\Logging\QuantConnect.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vectors\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
