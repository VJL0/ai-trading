{
  "_comment": "LAT Alpaca PAPER template (LEAN live mode + official Alpaca plugin behind GatedAlpacaBrokerage). NO SECRETS: scripts/lean_paper_alpaca.sh merges the PAPER keys from SecretStore into a per-run 0600 config under trading/lean/runs/ and deletes it on exit. alpaca-paper-trading is hard-coded true here, re-asserted by trading/lean/tools/lat_lean.py and ignored by GatedAlpacaBrokerage (which always passes isPaperTrading: true). There is no live template.",
  "live-mode": true,
  "live-mode-brokerage": "GatedAlpacaBrokerage",
  "data-queue-handler": ["GatedAlpacaBrokerage"],
  "setup-handler": "QuantConnect.Lean.Engine.Setup.BrokerageSetupHandler",
  "result-handler": "QuantConnect.Lean.Engine.Results.LiveTradingResultHandler",
  "data-feed-handler": "QuantConnect.Lean.Engine.DataFeeds.LiveTradingDataFeed",
  "real-time-handler": "QuantConnect.Lean.Engine.RealTime.LiveTradingRealTimeHandler",
  "transaction-handler": "QuantConnect.Lean.Engine.TransactionHandlers.BrokerageTransactionHandler",
  "history-provider": ["BrokerageHistoryProvider", "SubscriptionDataReaderHistoryProvider"],
  "algorithm-type-name": "Lat.Lean.Algorithms.LatIntentBridgeAlgorithm",
  "alpaca-paper-trading": true,
  "alpaca-api-key": "",
  "alpaca-api-secret": "",
  "alpaca-access-token": "",
  "force-exchange-always-open": false,
  "ignore-unknown-asset-holdings": false,
  "lat-gateway": "LEAN_ALPACA_PAPER",
  "lat-mode": "PAPER",
  "lat-execution-label": "PAPER",
  "lat-resolution": "Minute",
  "lat-exit-after-seconds": "0",
  "lat-poll-ms": "500",
  "lat-heartbeat-ms": "2000"
}
